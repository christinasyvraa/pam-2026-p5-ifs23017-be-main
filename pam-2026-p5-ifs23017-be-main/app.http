## Global Variabel
#@BaseUrl = https://pam-2026-p5-ifs23017-be.delcom.org:8080
#@BaseUrl = https://pam-2026-p5-ifs23017-be.cipaa.fun:8080
#@BaseUrl = http://pam-2026-p5-ifs23017-be.cipaa.fun:8080
@BaseUrl = https://pam-2026-p5-ifs23017-be-main.cipaa.fun:8080/

### ---------------------------------------
## Auth
### ---------------------------------------

### Inisialisasi kredensial uji (selalu unik tiap Run All)
# @name InitTestVars
GET {{BaseUrl}}/
Content-Type: application/json

> {%
    const suffix = Date.now().toString();
    client.global.set("testerUsername", "tester_" + suffix);
    client.global.set("testerPassword", "tester123");
    client.global.set("testerNewPassword", "tester456");
%}

### Melakukan pendaftaran
# @name PostRegister
POST {{BaseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Tester",
  "username": "{{testerUsername}}",
  "password": "{{testerPassword}}"
}

### Masuk ke layanan
# @name PostLogin
POST {{BaseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{testerUsername}}",
  "password": "{{testerPassword}}"
}

> {%
    if (response.status === 200 && response.body && response.body.data) {
        client.global.set("authToken", response.body.data.authToken);
        client.global.set("refreshToken", response.body.data.refreshToken);
    }
%}

### Keluar dari layanan (skip run)
# @name PostLogout
POST {{BaseUrl}}/auth/logout
Content-Type: application/json

{
  "authToken": "{{authToken}}"
}

### Masuk ke layanan
POST {{BaseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{testerUsername}}",
  "password": "{{testerPassword}}"
}

> {%
    if (response.status === 200 && response.body && response.body.data) {
        client.global.set("authToken", response.body.data.authToken);
        client.global.set("refreshToken", response.body.data.refreshToken);
    }
%}

### ---------------------------------------
## Users
### ---------------------------------------

### Mengambil informasi akun
# @name GetUserMe
GET {{BaseUrl}}/users/me
Authorization: Bearer {{authToken}}
Content-Type: application/json

> {%
    if (response.status === 200 && response.body && response.body.data && response.body.data.user) {
        client.global.set("userId", response.body.data.user.id);
    }
%}

### Mengubah informasi akun
# @name PutUserMe
PUT {{BaseUrl}}/users/me
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Tester Update",
  "username": "{{testerUsername}}"
}

### Mengubah kata sandi akun
# @name PutUserMePassword
PUT {{BaseUrl}}/users/me/password
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "newPassword": "{{testerNewPassword}}",
  "password": "{{testerPassword}}"
}

> {%
    if (response.status === 200) {
        client.global.set("testerPassword", client.global.get("testerNewPassword"));
    }
%}

### Login ulang (token lama tidak berlaku setelah ganti password)
# @name PostLoginAfterPasswordChange
POST {{BaseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{testerUsername}}",
  "password": "{{testerPassword}}"
}

> {%
    if (response.status === 200 && response.body && response.body.data) {
        client.global.set("authToken", response.body.data.authToken);
        client.global.set("refreshToken", response.body.data.refreshToken);
    }
%}

### Mengubah photo profile
# @name PutUserMePhoto
PUT {{BaseUrl}}/users/me/photo
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="example.png"
Content-Type: image/png

< ./uploads/examples/me.png
--WebAppBoundary--

### Mengambil photo profile berdasarkan id user
### Jalankan GetUserMe dulu agar variable global {{userId}} terisi

# @name GetMyPhoto
GET {{BaseUrl}}/images/users/{{userId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

### ---------------------------------------
## Todos
### ---------------------------------------

### Mengambil semua data todo user saat ini
# @name GetTodos
GET {{BaseUrl}}/todos?search=
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Menambahkan todo
# @name PostTodos
POST {{BaseUrl}}/todos
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Judul Todo",
  "description": "Deskripsi Todo",
  "urgency": "MEDIUM"
}

> {%
    if (response.status === 200 && response.body && response.body.data) {
        client.global.set("todoId", response.body.data.todoId);
    }
%}

### Mengambil todo dengan id
# @name GetTodoById
GET {{BaseUrl}}/todos/{{todoId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Mengubah todo
# @name PutTodo
PUT {{BaseUrl}}/todos/{{todoId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Judul Todo",
  "description": "Deskripsi Todo",
  "urgency": "HIGH",
  "isDone": true
}

### Mengubah cover todo
# @name PutTodoCover
PUT {{BaseUrl}}/todos/{{todoId}}/cover
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="example.png"
Content-Type: image/png

< ./uploads/examples/me.png
--WebAppBoundary--

### Mengambil cover todo
# @name GetTodoCover
GET {{BaseUrl}}/images/todos/{{todoId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Menghapus todo
# @name DeleteTodo
DELETE {{BaseUrl}}/todos/{{todoId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

a


